# === Server-Side Secrets (Vercel / Serverless Proxy) ===
# Set this in Vercel Dashboard -> Settings -> Environment Variables (NEVER prefix with VITE_)
OPENAI_API_KEY=

# Optional comma-separated extra allowed origins for CORS on /api/tts and /api/chat
ALLOWED_ORIGINS=

# === Client-Side Optional Config ===
# Point to your Vercel deployment URL if hosting frontend on GitHub Pages (e.g. https://heysis.vercel.app)
# Leave empty when frontend and /api/* are hosted together on Vercel
VITE_PROXY_URL=

# Optional: Local development keys only (users can also enter their own keys inside the app)
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
